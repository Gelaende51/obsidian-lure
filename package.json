{
	"name": "lure",
	"version": "1.6.1",
	"description": "Shows a clickable, editable breadcrumb of the vault path in each note's header.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && npm run lint && npm run check:lang && npm run check:listing && node esbuild.config.mjs production",
		"check:lang": "node scripts/check-translations.mjs",
		"check:listing": "node scripts/check-listing.mjs",
		"check:minver": "node scripts/check-min-app-version.mjs",
		"tags": "node scripts/obsidian-listing-tags.mjs",
		"lint": "eslint src",
		"stamp": "node scripts/i18n-stamp.mjs"
	},
	"license": "AGPL-3.0-only",
	"devDependencies": {
		"development-template": "https://codeload.github.com/Gelaende51/development-template/tar.gz/refs/tags/v1.1.0",
		"electron-template": "https://codeload.github.com/Gelaende51/electron-template/tar.gz/refs/tags/v0.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"obsidian-toolkit": "https://codeload.github.com/Gelaende51/obsidian-toolkit/tar.gz/refs/tags/v0.3.0",
		"tslib": "^2.6.0",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.71.1"
	},
	"dependencies": {
		"picomatch": "^4.0.7"
	}
}
