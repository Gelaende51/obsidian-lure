# Dependencies
node_modules/

# Build output
main.js
*.js.map
*.zip

# Obsidian plugin data
data.json

# Local agent config — never published
.claude/

# Belt and braces: .personal/ holds local-only material (issue notes, test
# vaults, filled-in credentials). Its own rule so that removing the .claude/
# line above cannot expose it by accident.
.personal/
**/.personal/

# Belt and braces: personal.md holds credentials. Kept as its own rule so
# that removing the .claude/ line above cannot expose it by accident.
personal.md
**/personal.md

# OS
.DS_Store
